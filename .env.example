# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
IS_PROD_DB=0
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gastos
DB_USER=postgres
DB_PASSWORD=
# Used instead of the above when IS_PROD_DB=1
DB_PROD_URL=

# ── Web app ───────────────────────────────────────────────────────────────────
SECRET_KEY=
ADMIN_PASSWORD=
NOTIFICATION_SECRET=
# Public HTTPS base of the web app (also used to build OAuth callback URLs)
WEBAPP_URL=https://your-domain

# ── Investment / Alpaca (read-only OAuth) ─────────────────────────────────────
# Master key that encrypts clients' Alpaca tokens at rest (core.client_investment).
# Generate once with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Per-client Alpaca API keys are loaded from the Administración panel and
# stored encrypted (see ENCRYPTION_KEY above) — no app-level Alpaca
# credentials are needed here. ALPACA_API_BASE selects the environment for
# ALL clients: keys must match it (paper keys ↔ paper-api, live keys ↔ api).
ALPACA_API_BASE=https://api.alpaca.markets
# Seconds to cache each client's portfolio summary (avoids re-hitting Alpaca
# on every page view; a worker is only tied up once per client per window).
ALPACA_CACHE_TTL_SECONDS=180

# ── PayPal (motor de pagos, Fase 2) ───────────────────────────────────────────
# App REST de developer.paypal.com. PAYPAL_MODE decide el ambiente ('sandbox'
# o 'live') — las credenciales y el webhook id deben ser de ESE ambiente.
# Los cobros van SIEMPRE en USD (PayPal no soporta CRC).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Id del webhook registrado en el dashboard (URL: <WEBAPP_URL>/paypal/webhook).
# Sin él, TODOS los webhooks se rechazan (verificación fail-closed).
PAYPAL_WEBHOOK_ID=

# ── External APIs (existing) ──────────────────────────────────────────────────
OPENAI_API_KEY=
AI_ASSISTANCE=0

# ── WhatsApp: respuestas por audio (chat AI) ──────────────────────────────────
# Switch: con 1, cuando el cliente envía nota de voz el agente responde con
# texto + nota de voz (TTS de OpenAI, misma OPENAI_API_KEY). Apagar = 0 y
# reiniciar whatsapp-agent-worker.
WHATSAPP_AUDIO_REPLIES=0
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voces: coral (default, cálida), ash, sage, nova, alloy... El estilo de habla
# se dirige con OPENAI_TTS_INSTRUCTIONS (default en whatsapp_agent_worker.py).
OPENAI_TTS_VOICE=coral
