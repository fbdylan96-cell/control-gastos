# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
IS_PROD_DB=0
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gastos
DB_USER=postgres
DB_PASSWORD=
# Used instead of the above when IS_PROD_DB=1
DB_PROD_URL=

# ── Web app ───────────────────────────────────────────────────────────────────
SECRET_KEY=
ADMIN_PASSWORD=
NOTIFICATION_SECRET=
# Public HTTPS base of the web app (also used to build OAuth callback URLs)
WEBAPP_URL=https://your-domain

# ── Investment / Alpaca (read-only OAuth) ─────────────────────────────────────
# Master key that encrypts clients' Alpaca tokens at rest (core.client_investment).
# Generate once with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# OAuth app credentials from https://app.alpaca.markets/connect
# (the app must be registered/approved by Alpaca before clients can use it).
# Callback URLs are derived from WEBAPP_URL — register BOTH in the Alpaca app:
#   {WEBAPP_URL}/persona/inversion/callback
#   {WEBAPP_URL}/empresa/inversion/callback
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=
# LEAVE EMPTY for read-only access (Alpaca grants reads with no scope).
# Never add 'trading' (order execution) or 'account:write' (config/watchlist writes).
ALPACA_SCOPE=
ALPACA_API_BASE=https://api.alpaca.markets
# Seconds to cache each client's portfolio summary (avoids re-hitting Alpaca
# on every page view; a worker is only tied up once per client per window).
ALPACA_CACHE_TTL_SECONDS=180

# ── External APIs (existing) ──────────────────────────────────────────────────
OPENAI_API_KEY=
AI_ASSISTANCE=0
