# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
IS_PROD_DB=0
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gastos
DB_USER=postgres
DB_PASSWORD=
# Used instead of the above when IS_PROD_DB=1
DB_PROD_URL=

# ── Web app ───────────────────────────────────────────────────────────────────
SECRET_KEY=
ADMIN_PASSWORD=
NOTIFICATION_SECRET=

# ── Investment / Alpaca (read-only OAuth) ─────────────────────────────────────
# Master key that encrypts clients' Alpaca tokens at rest (core.client_investment).
# Generate once with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# OAuth app credentials from https://app.alpaca.markets/connect
# (the app must be registered/approved by Alpaca before clients can use it).
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=
ALPACA_REDIRECT_URI=https://your-domain/persona/inversion/callback
# Read-only scope: do NOT add 'trading' here — tokens must not be able to place orders.
# Confirm the exact read-only scope string in Alpaca's docs before going live.
ALPACA_SCOPE=account:write
ALPACA_API_BASE=https://api.alpaca.markets

# ── External APIs (existing) ──────────────────────────────────────────────────
OPENAI_API_KEY=
AI_ASSISTANCE=0
