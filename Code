      `  ${i + 1}. mt=${r.mt} size=${r.size} hasData=${r.hasData} att=${r.att} file=${r.filename}`
    );
  });

  const cnt = mt => rows.filter(r => r.mt === mt).length;
  console.log(`🧮 count text/html=${cnt('text/html')} text/plain=${cnt('text/plain')}`);
}

/************************************************************
 * RAW RFC822 helpers (los dejé igual por si los usas luego)
 ************************************************************/

function extractTextFromRawMessage_(gmailId) {
  try {
    const msg = Gmail.Users.Messages.get('me', gmailId, { format: 'raw' });
    const rawB64 = msg.raw || '';
    if (!rawB64) return '';

    const rfc822 = decodeBody_(rawB64);
    if (!rfc822) return '';

    const parsed = parseRfc822_(rfc822);
    if (!parsed) return '';

    const plain = (parsed.partsTextPlain || []).join('\n\n').trim();
    if (plain) return normalizeWeirdWhitespace_(plain);

    const html = (parsed.partsTextHtml || []).join('\n\n').trim();
    if (html) return normalizeWeirdWhitespace_(htmlToText_(html));

    return '';
  } catch (e) {
    console.warn(`⚠️ RAW parse falló (${gmailId}): ${e.message}`);
    return '';
  }
}

function parseRfc822_(rfc822) {
  const split = splitHeadersBody_(rfc822);
  if (!split) return null;

  const headers = split.headers;
  const body = split.body;

  const ct = (headers['content-type'] || '').toLowerCase();
  const boundary = extractBoundary_(ct);

  const out = { partsTextPlain: [], partsTextHtml: [] };

  if (boundary) {
    const parts = splitByBoundary_(body, boundary);
    for (const p of parts) parseMimePart_(p, out);
  } else {
    parseMimePart_(rfc822, out);
  }

  return out;
}

function parseMimePart_(partRaw, out) {
  const split = splitHeadersBody_(partRaw);
  if (!split) return;

  const headers = split.headers;
  const body = split.body;

  const ct = (headers['content-type'] || 'text/plain').toLowerCase();
  const cte = (headers['content-transfer-encoding'] || '').toLowerCase();

  const boundary = extractBoundary_(ct);
  if (boundary) {
    const parts = splitByBoundary_(body, boundary);
    for (const p of parts) parseMimePart_(p, out);
    return;
  }

  let decoded = decodeContentTransfer_(body, cte);
  decoded = decodedHtmlEntitySafe_(decoded);

  if (ct.includes('text/plain')) out.partsTextPlain.push(decoded);
  else if (ct.includes('text/html')) out.partsTextHtml.push(decoded);
}

function splitHeadersBody_(raw) {
  const s = String(raw || '');
  const idx = s.search(/\r?\n\r?\n/);
  if (idx < 0) return null;

  const headerStr = s.slice(0, idx);
  const body = s.slice(idx).replace(/^\r?\n\r?\n/, '');

  const headers = parseHeaders_(headerStr);
  return { headers, body };
}

function parseHeaders_(headerStr) {
  const lines = String(headerStr || '').split(/\r?\n/);

  const unfolded = [];
  for (const line of lines) {
    if (/^\s/.test(line) && unfolded.length) unfolded[unfolded.length - 1] += ' ' + line.trim();
    else unfolded.push(line.trim());
  }

  const headers = {};
  for (const line of unfolded) {
    const m = line.match(/^([^:]+):\s*(.*)$/);
    if (!m) continue;
    headers[String(m[1]).toLowerCase()] = String(m[2] || '').trim();
  }
  return headers;
}

function extractBoundary_(contentType) {
  const m = String(contentType || '').match(/boundary="?([^";]+)"?/i);
  return m ? m[1] : '';
}

function splitByBoundary_(body, boundary) {
  const b = String(boundary || '');
  if (!b) return [];

  const s = String(body || '');
  const marker = '--' + b;
  const endMarker = marker + '--';

  const chunks = [];
  const lines = s.split(/\r?\n/);

  let buf = [];
  let inPart = false;

  for (const line of lines) {
    if (line.startsWith(endMarker)) {
      if (buf.length) chunks.push(buf.join('\n'));
      buf = [];
      inPart = false;
      break;
    }
    if (line.startsWith(marker)) {
      if (buf.length) chunks.push(buf.join('\n'));
      buf = [];
      inPart = true;
      continue;
    }
    if (inPart) buf.push(line);
  }

  if (buf.length) chunks.push(buf.join('\n'));
  return chunks.map(x => x.trim()).filter(Boolean);
}

function decodeContentTransfer_(body, cte) {
  const enc = String(cte || '').toLowerCase();
  const s = String(body || '');

  if (enc === 'base64') {
    return Utilities.newBlob(Utilities.base64Decode(s.replace(/\s/g, ''))).getDataAsString('UTF-8');
  }
  if (enc === 'quoted-printable') return decodeQuotedPrintable_(s);
  return s;
}

function decodeQuotedPrintable_(input) {
  let s = String(input || '');
  s = s.replace(/=\r?\n/g, '');
  s = s.replace(/=([0-9A-Fa-f]{2})/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)));
  return s;
}

function decodedHtmlEntitySafe_(s) {
  return decodeHtmlEntities_(String(s || ''));
}

