/************************************************************
 * MASTER GASTOS - EXTRACTOR MULTICLIENTE (1 correo / minuto)
 *
 * Code.gs:
 * - Lee correos (Gmail label) -> escribe en RAW con columnas correctas
 * - Extrae body FULL (prioriza HTML, soporta attachmentId)
 * - Parsing robusto: BAC + Promérica (incluye HTML entities y "Monto CRC: ...")
 * - Limpia merchant/desc desde Code
 *
 * ✅ NUEVO:
 * - BAC "Notificación de Transferencia" -> SÍ se procesa como "Transferencia BAC"
 * - BAC subject "Transferencia" -> NO se procesa (transferencia propia)
 *
 * ✅ CAMBIO CLAVE (LO QUE PEDISTE):
 * - ❌ Se elimina "snippet" del todo
 * - ✅ Se escribe en RAW SIEMPRE por NOMBRE DE COLUMNA (headers),
 *    así puedes reordenar columnas sin romper nada.
 *
 * ✅ NUEVO (LO QUE PEDISTE HOY):
 * - BAC COMPRA: merchant_guess extrae SOLO lo que está después de "Comercio:"
 *   y corta antes de "Ciudad y país / Ciudad y pa&iacute;s"
 * - Quita "Ciudad y país: SAN JOSE, Costa Rica" de merchant_guess y desc_guess
 ************************************************************/

/******************* CONFIGURACIÓN BÁSICA *******************/

// Clientes_SpreadsheetID is defined in MataCloudAPI-credentials.js

const CLIENTS_SHEET_NAME = 'Clientes';
const GMAIL_EXPENSE_LABEL = 'Finanzas Personales';

const MASTER_CFG = {
  BODY_FULL_MAX_CHARS: 20000,
  BODY_CONDENSED_MAX: 1200,
  MAX_PER_RUN: 5,
  MARK_AS_READ: true,
  BLACKOUT_START_HOUR: 1,
  BLACKOUT_END_HOUR: 5,
};

/************************************************************
 * ENTRYPOINT
 ************************************************************/

function runMasterOnce() {
  try {
    // BLACKOUT 1am-5am
    const currentHour = new Date().getHours();
    if (
      currentHour >= MASTER_CFG.BLACKOUT_START_HOUR &&
      currentHour < MASTER_CFG.BLACKOUT_END_HOUR
    ) {
      console.log('💤 Blackout (1am-5am).');
      return;
    }

    // FAST FAIL: Gmail primero
    const messagesToProcess = findNextExpenseMessages_();
    if (!messagesToProcess.length) return;

    console.log('--- 🏁 INICIO EJECUCIÓN (Correo detectado) ---');
    console.log(`⚡ Se encontraron ${messagesToProcess.length} correos.`);

    const clientsMap = loadClientsConfig_();
    if (!clientsMap.size) {
      console.warn('⚠️ No se encontraron clientes activos.');
      for (const m of messagesToProcess) safeMarkAsProcessed_(m.id);
      return;
    }

    for (let i = 0; i < messagesToProcess.length; i++) {
      const msgMeta = messagesToProcess[i];
      console.log(
        `\n--- 🔄 Procesando mensaje ${i + 1} de ${messagesToProcess.length} (ID: ${msgMeta.id}) ---`
      );

      try {
        const fullMsg = Gmail.Users.Messages.get('me', msgMeta.id, { format: 'full' });
        const meta = readHeadersFull_(fullMsg);

        console.log(`📩 Asunto: [${meta.subject}] | De: [${meta.from}]`);

        const alias = detectAliasFromHeaders_(meta);
        if (!alias) {
          console.warn(`⚠️ Alias no detectado. To: ${meta.to}`);
          safeMarkAsProcessed_(fullMsg.id);
          continue;
        }

        const client = clientsMap.get(alias.toLowerCase());
        if (!client) {
          console.warn(`⚠️ Cliente no configurado: ${alias}`);
          safeMarkAsProcessed_(fullMsg.id);
          continue;
        }

        console.log(
          `👤 Cliente: ${alias} -> Sheet: https://docs.google.com/spreadsheets/d/${client.spreadsheetId}/edit`
        );

        const ss = SpreadsheetApp.openById(client.spreadsheetId);
        const shRaw = ensureRawSheetClient_(ss);

        // Dedup por Gmail ID (col messageId) PERO por nombre de columna
        if (checkIfMessageExistsInSheet_(shRaw, fullMsg.id)) {
          console.log('⏭️ OMITIDO: Ya existe en RAW.');
          safeMarkAsProcessed_(fullMsg.id);
          continue;
        }

        processMessageForClient_(fullMsg, alias, ss, shRaw);
        logPayloadTree_(fullMsg.payload, fullMsg.id);

        safeMarkAsProcessed_(fullMsg.id);
      } catch (innerError) {
        console.error(`❌ Error en msg ${msgMeta.id}: ${innerError.message}`);
      }
    }

    console.log('\n--- 🎉 FIN EJECUCIÓN DEL LOTE ---');
  } catch (e) {
    console.error(`💥 ERROR FATAL: ${e.message}`);
  }
}

/************************************************************
 * GMAIL: LISTAR MENSAJES A PROCESAR
 ************************************************************/

function findNextExpenseMessages_() {
  const q = `label:"${GMAIL_EXPENSE_LABEL}" is:unread`;
  const list = Gmail.Users.Messages.list('me', { q, maxResults: MASTER_CFG.MAX_PER_RUN + 3 });
  const msgs = list.messages || [];
  if (!msgs.length) return [];

  const candidates = [];
  for (const m of msgs) {
    const meta = Gmail.Users.Messages.get('me', m.id, {
      format: 'metadata',
      metadataHeaders: ['Date'],
    });
    candidates.push({ id: meta.id, internalDate: Number(meta.internalDate || 0) });
  }

  candidates.sort((a, b) => b.internalDate - a.internalDate);
  return candidates.slice(0, MASTER_CFG.MAX_PER_RUN);
}

/************************************************************
 * CLIENTES CONFIG
 ************************************************************/

function loadClientsConfig_() {
  const ss = SpreadsheetApp.openById(Clientes_SpreadsheetID);
  const sh = ss.getSheetByName(CLIENTS_SHEET_NAME);
  if (!sh) throw new Error(`No existe la hoja "${CLIENTS_SHEET_NAME}"`);

  const lastRow = sh.getLastRow();
  const lastCol = sh.getLastColumn();
  if (lastRow < 2) return new Map();

  const values = sh.getRange(1, 1, lastRow, lastCol).getValues();
  const headers = values[0].map(h => String(h || '').trim());

  const iEmail = headers.indexOf('email_forward');
  const iSsUrl = headers.indexOf('spreadsheetId');
  const iActive = headers.indexOf('active');

  if (iEmail < 0 || iSsUrl < 0) throw new Error('Faltan columnas email_forward o spreadsheetId');

  const map = new Map();

  for (let r = 1; r < values.length; r++) {
    const row = values[r];
    const email = String(row[iEmail] || '').trim();
    const url = String(row[iSsUrl] || '').trim();
    const activeVal = iActive >= 0 ? row[iActive] : true;

    if (!email || !url) continue;

    const isActive =
      String(activeVal).toLowerCase() !== 'false' && String(activeVal).toUpperCase() !== 'NO';
    if (!isActive) continue;

    const ssIdClient = extractSpreadsheetIdFromUrl_(url);
    if (ssIdClient) map.set(email.toLowerCase(), { alias: email, spreadsheetId: ssIdClient });
  }

  console.log(`👥 Clientes activos cargados: ${map.size}`);
  console.log('🔑 Aliases cargados (primeros 30):');
  Array.from(map.keys()).slice(0, 30).forEach(k => console.log('  - ' + k));

  return map;
}

/************************************************************
 * PROCESAR MENSAJE -> ESCRIBIR RAW
 ************************************************************/

function processMessageForClient_(fullMsg, alias, ss, shRaw) {
  const payload = fullMsg.payload || {};
  logPayloadTree_(payload, fullMsg.id);

  const meta = readHeadersFull_(fullMsg);

  // ✅ NO procesar transferencias propias BAC (subject "Transferencia")
  if (shouldSkipBacTransfer_(meta)) {
    console.log(`⛔ BAC Transferencia (propia) omitida | Subject=[${meta.subject}]`);
    return; // NO escribir en RAW
  }

  // ✅ FIX: extraer body FULL preferente HTML (SIN snippet)
  const bodyFull = extractBodyFullPreferHtml_(payload, fullMsg.id);
  const bodyCond = condenseBank_(bodyFull);

  console.log(`🧾 body_full_len=${bodyFull.length}`);

  // ✅ BAC / Promerica / Davibank (SIN snippet)
  const guesses = guessFields_(meta.subject, bodyFull, meta.from);

  // Limpieza desde ORIGEN
  const merchantRaw = String(guesses.merchant_guess || '').trim();
  const merchantClean = normalizeMerchantAtSource_(merchantRaw);
  guesses.merchant_guess = merchantClean;

  const descRaw = String(guesses.desc_guess || '').trim();
  const descClean = cleanDescGuessAtSource_(descRaw);
  guesses.desc_guess = descClean;

  if (
    guesses.amount_guess === '' ||
    guesses.amount_guess === null ||
    typeof guesses.amount_guess === 'undefined'
  ) {
    console.warn(`⚠️ No se detectó monto. Subject=[${meta.subject}]`);
  }

  // ✅ Construimos un OBJETO por header, no un array posicional
  const rowObj = buildRawRowObjectClient_({
    meta,
    bodyFull,
    bodyCond,
    guesses,
    labelSource: GMAIL_EXPENSE_LABEL,
  });

  // Insertar fila 2 y pegar por nombre de columna
  shRaw.insertRowsBefore(2, 1);
  writeRowByHeaders_(shRaw, 2, rowObj);

  forceCheckboxFalseIfPresent_(shRaw, 2, '💾 Crear Regla Permanente');

  console.log(
    `💾 RAW | ${alias} | ${guesses.currency_guess} ${guesses.amount_guess} | merchant: "${merchantRaw}" -> "${merchantClean}"`
  );
}

/************************************************************
 * ✅ NUEVO: FILTRO BAC TRANSFERENCIA PROPIA (NO PROCESAR)
 ************************************************************/
function shouldSkipBacTransfer_(meta) {
  const from = String(meta?.from || '').toLowerCase();
  const subj = String(meta?.subject || '').trim();

  if (!from.includes('alerta@baccredomatic.com')) return false;

  // Si contiene "Notificación de Transferencia" => SÍ se procesa
  if (isBacTransferNotificationSubject_(subj)) return false;

  // Si el subject es solo "Transferencia" => NO se procesa
  const subjNorm = normalizeTextForCompare_(subj);
  if (subjNorm === 'transferencia') return true;

  return false;
}

function isBacTransferNotificationSubject_(subject) {
  const s = normalizeTextForCompare_(subject);
  return s.includes('notificacion de transferencia');
}

function normalizeTextForCompare_(s) {
  return String(s || '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

/************************************************************
 * ✅ FIX CENTRAL: BODY FULL (preferir HTML + attachments)
 * (SIN snippet)
 ************************************************************/
function extractBodyFullPreferHtml_(payload, gmailId) {
  const htmlParts = [];
  const textParts = [];

  // 1) Intento normal con Gmail API
  traverseParts_(payload, part => {
    const mt = (part.mimeType || '').toLowerCase();
    const body = part.body || {};
    if (!body.data) return;

    const content = decodeBody_(body.data);
    if (!content) return;

    if (mt === 'text/html') htmlParts.push(content);
    else if (mt === 'text/plain') textParts.push(content);
  });

  // 2) HTML desde Gmail API
  if (htmlParts.length) {
    const htmlJoined = htmlParts.join('\n\n');
    const text = htmlToText_(htmlJoined);

    if (hasMoneyPattern_(text)) {
      return cleanAndClamp_(text, MASTER_CFG.BODY_FULL_MAX_CHARS);
    }
  }

  // 3) Texto plano desde Gmail API
  if (textParts.length) {
    const text = normalizeWeirdWhitespace_(textParts.join('\n\n'));
    if (hasMoneyPattern_(text)) {
      return cleanAndClamp_(text, MASTER_CFG.BODY_FULL_MAX_CHARS);
    }
  }

  // 4) 🔥 FALLBACK: GmailApp
  try {
    const msg = GmailApp.getMessageById(gmailId);

    const html = msg.getBody();
    const textFromHtml = htmlToText_(html);

    if (hasMoneyPattern_(textFromHtml)) {
      console.log('✅ Body obtenido vía GmailApp.getBody()');
      return cleanAndClamp_(textFromHtml, MASTER_CFG.BODY_FULL_MAX_CHARS);
    }

    const plain = msg.getPlainBody();
    if (hasMoneyPattern_(plain)) {
      console.log('✅ Body obtenido vía GmailApp.getPlainBody()');
      return cleanAndClamp_(plain, MASTER_CFG.BODY_FULL_MAX_CHARS);
    }
  } catch (e) {
    console.warn(`⚠️ GmailApp fallback falló (${gmailId}): ${e.message}`);
  }

  // 5) Último recurso: vacío (NO snippet)
  return '';
}

function hasMoneyPattern_(text) {
  if (!text) return false;
  return (
    /\b(CRC|USD|EUR)\b[\s:]*[\d.,]+/i.test(text) ||
    /[\d.,]+[\s:]*\b(CRC|USD|EUR)\b/i.test(text) ||
    /₡\s*[\d.,]+/.test(text) ||
    /\$\s*[\d.,]+/.test(text)
  );
}

/************************************************************
 * ✅ NUEVO: BAC COMPRA LIMPIO (merchant/desc)
 ************************************************************/

/**
 * Extrae el comercio BAC:
 * "Comercio: SERVICENTRO LA GALERA Ciudad y país: SAN JOSE, Costa Rica"
 * o con entities:
 * "Comercio: ... Ciudad y pa&iacute;s: ..."
 */
function extractBacCompraMerchant_(text) {
  const t = normalizeWeirdWhitespace_(String(text || ''));

  // Corta antes de "Ciudad y pa..." (funciona para país / pais / pa&iacute;s)
  const m = t.match(/Comercio:\s*(.+?)(?=\s*Ciudad\s+y\s+pa)/i);
  if (m && m[1]) return String(m[1]).trim();

  // fallback: si no hay "Ciudad y pa", toma hasta "Fecha" o "Monto"
  const m2 = t.match(/Comercio:\s*(.+?)(?=\s*(Fecha|Monto|VISA|Autorizaci[oó]n|Referencia|Tipo\s+de\s+Transacci[oó]n)\b|$)/i);
  if (m2 && m2[1]) return String(m2[1]).trim();

  return '';
}

/**
 * Quita cualquier tramo "Ciudad y país: SAN JOSE, Costa Rica" o variantes.
 * (También cubre caso "Ciudad y pa&iacute;s")
 */
function stripBacCityCountry_(s) {
  let t = String(s || '');

  // corta desde "Ciudad y pa" hasta fin (porque ahí empieza el bloque molesto)
  t = t.replace(/\s*Ciudad\s+y\s+pa[\s\S]*$/i, '');

  // por si viene embebido en medio:
  t = t.replace(/Ciudad\s+y\s+pa[\s\S]*?(?=(Fecha|Monto|VISA|Autorizaci[oó]n|Referencia|Tipo\s+de\s+Transacci[oó]n|$))/gi, ' ');

  t = t.replace(/\s+/g, ' ').trim();
  return t;
}

/************************************************************
 * GUESS FIELDS (BAC + Promérica + DAVIbank) (SIN snippet)
 ************************************************************/

function guessFields_(subject, body, fromHeader) {
  const tRaw = `${subject || ''}\n${body || ''}`;
  const t = normalizeWeirdWhitespace_(tRaw);

  const from = String(fromHeader || '').toLowerCase();
  const subj = String(subject || '').trim();

  /***********************
   * ✅ DAVIbank
   ***********************/
  if (from.includes('alertas@davibank.cr') || from.includes('davibank')) {
    const ac = parseAmountCurrency_(t);

    // Captura lo que va después de "transacción realizada en" y antes de coma o "el día"
    let mm =
      t.match(/transacci[oó]n\s+realizada\s+en\s+(.+?)(?=,|\s+el\s+d[ií]a|\s+el\s+dia|$)/i) ||
      t.match(/transaccion\s+realizada\s+en\s+(.+?)(?=,|\s+el\s+dia|$)/i);

    let merchant = mm ? String(mm[1] || '').trim() : '';

    merchant = merchant.replace(/\s{2,}/g, ' ').trim();

    return {
      merchant_guess: merchant,
      amount_guess: ac.amount,
      currency_guess: ac.currency,
      desc_guess: merchant ? `Compra en ${merchant}` : '',
    };
  }

  /***********************
   * ✅ BAC COMPRA (notificacionesbaccr.com y baccredomatic)
   * Lo que pediste:
   * - merchant = solo Comercio
   * - desc = "Compra en {merchant}"
   * - sin "Ciudad y país..."
   ***********************/
  const isBacSender =
    from.includes('notificacionesbaccr.com') ||
    from.includes('baccredomatic.com');

  const isBacCompraLike =
    isBacSender &&
    /Comercio:/i.test(t) &&
    /Tipo\s+de\s+Transacci[oó]n:\s*COMPRA/i.test(t);

  if (isBacCompraLike) {
    const ac = parseAmountCurrency_(t);

    let merchant = extractBacCompraMerchant_(t);
    merchant = stripBacCityCountry_(merchant);

    let desc = merchant ? `Compra en ${merchant}` : '';
    desc = stripBacCityCountry_(desc);

    return {
      merchant_guess: merchant,
      amount_guess: ac.amount,
      currency_guess: ac.currency || 'CRC',
      desc_guess: desc,
    };
  }

  // ✅ BAC SINPE Móvil (si existía tu helper isBacSinpeMovilSubject_)
  if (from.includes('alerta@baccredomatic.com') && isBacSinpeMovilSubject_(subj)) {
    const ac = parseAmountCurrency_(t);
    const sinpeMerchant = parseBacSinpeMovilMerchant_(t);

    return {
      merchant_guess: sinpeMerchant || 'Transferencia BAC',
      amount_guess: ac.amount,
      currency_guess: ac.currency || 'CRC',
      desc_guess: sinpeMerchant ? `Transferencia BAC: ${sinpeMerchant}` : 'Transferencia BAC',
    };
  }

  // ✅ BAC Notificación de Transferencia
  if (from.includes('alerta@baccredomatic.com') && isBacTransferNotificationSubject_(subj)) {
    const ac = parseAmountCurrency_(t);
    const concept = parseBacTransferConcept_(t);

    return {
      merchant_guess: 'Transferencia BAC',
      amount_guess: ac.amount,
      currency_guess: ac.currency || 'CRC',
      desc_guess: concept ? `Transferencia BAC: ${concept}` : 'Transferencia BAC',
    };
  }

  // Comercio BAC / Promerica (genérico)
  let comercio = '';
  let m =
    t.match(
      /Comercio:\s*(.+?)(?=\s+(Ciudad\/?Pa[ií]s|Ciudad\s+y\s+pa[ií]s|Fecha\/?hora|Fecha|Monto|Importe|Total|N[uú]mero|Numero|Tarjeta|Referencia)\b|$)/i
    ) ||
    t.match(
      /Comercio\s+(.+?)(?=\s+(Tipo\s+de\s+Comercio|Ciudad\/?Pa[ií]s|Ciudad\s+y\s+pa[ií]s|Fecha\/?hora|Fecha|Monto|Importe|Total|N[uú]mero|Numero|Tarjeta|Referencia)\b|$)/i
    ) ||
    t.match(/Compra en\s+(.+?)(?=\s+(Ciudad\s+y\s+pa|Ciudad\/?Pa[ií]s|Monto:|Monto|CRC|USD|EUR|$))/i);

  if (m) comercio = String(m[1] || '').trim();

  const ac = parseAmountCurrency_(t);
  const desc = comercio ? `Compra en ${comercio}` : '';

  return {
    merchant_guess: comercio,
    amount_guess: ac.amount,
    currency_guess: ac.currency,
    desc_guess: desc,
  };
}

/**
 * ✅ NUEVO: extrae concepto de transferencia BAC:
 * "por concepto de: Ozempic________"
 */
function parseBacTransferConcept_(text) {
  const t = normalizeWeirdWhitespace_(String(text || ''));
  let m = t.match(
    /por\s+concepto\s+de:\s*(.+?)(?=\s*(el\s+n[uú]mero\s+de\s+referencia|muchas\s+gracias|¿tiene\s+dudas|\bBAC\b|$))/i
  );
  if (!m) return '';

  let concept = String(m[1] || '').trim();
  concept = concept.replace(/_+/g, ' ').replace(/\s{2,}/g, ' ').trim();
  return concept;
}

function parseAmountCurrency_(text) {
  const t = normalizeWeirdWhitespace_(String(text || ''));

  // ✅ DAVIbank / otros: "por USD 20.00" (o "por CRC 9,900.00")
  let m = t.match(/\bpor\s+(CRC|USD|EUR)\s*([\d]{1,3}(?:[.,][\d]{3})*(?:[.,][\d]{2})?)\b/i);
  if (m) return { currency: m[1].toUpperCase(), amount: normalizeNumber_(m[2]) };

  // Transferencias BAC: "por un monto de 41.000,00 CRC"
  m = t.match(
    /por\s+un\s+monto\s+de\s*[:\-]?\s*([\d]{1,3}(?:[.,][\d]{3})*(?:[.,][\d]{2})?)\s*(CRC|USD|EUR)\b/i
  );
  if (m) return { currency: m[2].toUpperCase(), amount: normalizeNumber_(m[1]) };

  // "Monto: CRC 3,578.00" o "Monto CRC: 2,999.00"
  m = t.match(/\bMonto\b[\s:]*\b(CRC|USD|EUR)\b[\s:]*([\d.,]+)\b/i);
  if (m) return { currency: m[1].toUpperCase(), amount: normalizeNumber_(m[2]) };

  // "CRC: 10,202.50"
  m = t.match(/\b(CRC|USD|EUR)\b\s*[:\-]?\s*([\d]{1,3}(?:[.,][\d]{3})*(?:[.,][\d]{2})?)\b/i);
  if (m) return { currency: m[1].toUpperCase(), amount: normalizeNumber_(m[2]) };

  // Símbolos (₡ o $)
  m = t.match(/₡\s*([\d]{1,3}(?:[.,][\d]{3})*(?:[.,][\d]{2})?)/);
  if (m) return { currency: 'CRC', amount: normalizeNumber_(m[1]) };

  m = t.match(/\$\s*([\d]{1,3}(?:[.,][\d]{3})*(?:[.,][\d]{2})?)/);
  if (m) return { currency: 'USD', amount: normalizeNumber_(m[1]) };

  return { currency: '', amount: '' };
}

function normalizeNumber_(s) {
  let x = String(s || '').trim();

  const hasComma = x.includes(',');
  const hasDot = x.includes('.');

  if (hasComma && hasDot) {
    if (x.lastIndexOf('.') > x.lastIndexOf(',')) {
      x = x.replace(/,/g, '');
    } else {
      x = x.replace(/\./g, '').replace(',', '.');
    }
  } else if (hasComma && !hasDot) {
    if (/,(\d{2})$/.test(x)) x = x.replace(',', '.');
    else x = x.replace(/,/g, '');
  } else {
    const dots = (x.match(/\./g) || []).length;
    if (dots > 1) x = x.replace(/\./g, '');
  }

  return x;
}

/************************************************************
 * LIMPIEZAS DESDE ORIGEN
 ************************************************************/

function cleanDescGuessAtSource_(input) {
  let s = String(input || '').trim();
  if (!s) return '';
  s = normalizeWeirdWhitespace_(s);

  // ✅ extra: por si se coló "Ciudad y pa..." dentro del desc
  s = stripBacCityCountry_(s);

  s = s.replace(/\s*Ciudad\s+y\s+pa\.?\s*$/i, '');
  s = s.replace(/\s*Ciudad\s+y\s+p[aá]is\.?\s*$/i, '');
  s = s.replace(/\s*Ciudad\s+y\s+p\.?\s*$/i, '');

  s = s.replace(/\s*[,;-]\s*$/g, '');
  return s.trim();
}

function normalizeMerchantAtSource_(s) {
  if (!s) return '';
  let t = normalizeWeirdWhitespace_(String(s).trim());

  // ✅ extra: por si se coló "Ciudad y pa..." en merchant
  t = stripBacCityCountry_(t);

  t = t.replace(/^compra en\s+/i, '');
  t = t.replace(/^pago en\s+/i, '');
  t = t.replace(/^pos\s+/i, '');

  t = t.replace(/\b(ciudad y pa|ciudad y país|ciudad y pais)\b/gi, ' ');
  t = t.replace(/\b(cr|costa rica)\b/gi, ' ');

  t = t.replace(/\buber\s+eats\b/gi, 'Uber Eats');
  if (/\buber\b/i.test(t) && /\b(rides|trip)\b/i.test(t)) t = 'Uber';
  if (/\buber\b/i.test(t) && /\beats\b/i.test(t)) t = 'Uber Eats';

  t = t.replace(/[*#\-–]/g, ' ');
  t = t.replace(/\s{2,}/g, ' ').trim();

  return smartTitleCaseMerchant_(t);
}

function smartTitleCaseMerchant_(s) {
  const t = String(s || '').trim();
  if (!t) return '';

  const exceptions = new Map([
    ['uber', 'Uber'],
    ['uber eats', 'Uber Eats'],
    ['apple', 'Apple'],
    ['apple.com', 'Apple.com'],
    ['spotify', 'Spotify'],
    ['amazon', 'Amazon'],
    ['amazon marketplace', 'Amazon Marketplace'],
    ['office depot', 'Office Depot'],
    ['transferencia bac', 'Transferencia BAC'],
  ]);

  const key = t.toLowerCase();
  if (exceptions.has(key)) return exceptions.get(key);

  return t
    .toLowerCase()
    .split(' ')
    .filter(Boolean)
    .map(w => {
      if (w.length <= 2 && /^[a-z]{1,2}$/.test(w)) return w.toUpperCase();
      if (['de', 'la', 'el', 'y', 'en', 'del'].includes(w)) return w;
      return w.charAt(0).toUpperCase() + w.slice(1);
    })
    .join(' ')
    .trim();
}

