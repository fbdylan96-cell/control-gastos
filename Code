/**
 * ✅ Pegar SIEMPRE por nombre de columna
 */
function writeRowByHeaders_(sheet, rowNum, rowObj) {
  const lastCol = sheet.getLastColumn();
  if (lastCol < 1) throw new Error('RAW no tiene headers en la fila 1.');

  const headers = sheet
    .getRange(1, 1, 1, lastCol)
    .getValues()[0]
    .map(h => String(h || '').trim());

  const values = new Array(lastCol).fill('');

  for (let c = 0; c < headers.length; c++) {
    const h = headers[c];
    if (!h) continue;
    if (Object.prototype.hasOwnProperty.call(rowObj, h)) {
      values[c] = rowObj[h];
    }
  }

  sheet.getRange(rowNum, 1, 1, lastCol).setValues([values]);
}

/************************************************************
 * DEDUP (por header "messageId", no por columna 1)
 ************************************************************/

function checkIfMessageExistsInSheet_(shRaw, messageId) {
  const lastRow = shRaw.getLastRow();
  if (lastRow < 2) return false;

  const col = findColumnByHeader_(shRaw, 'messageId');
  if (col < 1) {
    console.warn('⚠️ RAW no tiene columna messageId. No se puede deduplicar.');
    return false;
  }

  const data = shRaw.getRange(2, col, lastRow - 1, 1).getValues();
  const ids = data.flat().map(x => String(x || '').trim());
  return ids.includes(String(messageId || '').trim());
}

function findColumnByHeader_(sheet, headerName) {
  const lastCol = sheet.getLastColumn();
  if (lastCol < 1) return -1;
  const headers = sheet
    .getRange(1, 1, 1, lastCol)
    .getValues()[0]
    .map(h => String(h || '').trim());
  const idx = headers.indexOf(String(headerName || '').trim());
  return idx >= 0 ? idx + 1 : -1;
}

