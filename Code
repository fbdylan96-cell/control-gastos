/************************************************************
 * MIME HELPERS
 ************************************************************/

function traverseParts_(part, cb) {
  if (!part) return;
  cb(part);
  if (part.parts && part.parts.length) part.parts.forEach(p => traverseParts_(p, cb));
}

function decodeBody_(data) {
  if (typeof data !== 'string') return '';
  let b64 = data.replace(/-/g, '+').replace(/_/g, '/').replace(/\s/g, '');
  while (b64.length % 4 !== 0) b64 += '=';
  return Utilities.newBlob(Utilities.base64Decode(b64)).getDataAsString('UTF-8') || '';
}

/************************************************************
 * HTML -> TEXT (decode entities)
 ************************************************************/

function htmlToText_(html) {
  let s = String(html || '');

  s = s
    .replace(/<\s*br\s*\/?>/gi, '\n')
    .replace(/<\/\s*p\s*>/gi, '\n')
    .replace(/<\/\s*div\s*>/gi, '\n')
    .replace(/<\/\s*td\s*>/gi, ' \n')
    .replace(/<\/\s*tr\s*>/gi, '\n')
    .replace(/<\/\s*li\s*>/gi, '\n');

  s = s.replace(/<script[\s\S]*?<\/script>/gi, ' ');
  s = s.replace(/<style[\s\S]*?<\/style>/gi, ' ');

  s = s.replace(/<[^>]+>/g, ' ');

  s = decodeHtmlEntities_(s);
  s = normalizeWeirdWhitespace_(s);

  s = s
    .replace(/[ \t]+\n/g, '\n')
    .replace(/\n{3,}/g, '\n\n')
    .trim();

  return s;
}

function decodeHtmlEntities_(s) {
  let t = String(s || '');

  // básicos
  t = t.replace(/&nbsp;/gi, ' ');
  t = t.replace(/&amp;/gi, '&');
  t = t.replace(/&lt;/gi, '<');
  t = t.replace(/&gt;/gi, '>');
  t = t.replace(/&quot;/gi, '"');
  t = t.replace(/&#39;/g, "'");

  // ✅ NUEVO: entidades comunes en español (named)
  const named = {
    '&aacute;': 'á',
    '&eacute;': 'é',
    '&iacute;': 'í',
    '&oacute;': 'ó',
    '&uacute;': 'ú',
    '&ntilde;': 'ñ',
    '&uuml;': 'ü',
    '&Aacute;': 'Á',
    '&Eacute;': 'É',
    '&Iacute;': 'Í',
    '&Oacute;': 'Ó',
    '&Uacute;': 'Ú',
    '&Ntilde;': 'Ñ',
    '&Uuml;': 'Ü',
  };

  // reemplazo rápido por regex
  t = t.replace(/&(aacute|eacute|iacute|oacute|uacute|ntilde|uuml|Aacute|Eacute|Iacute|Oacute|Uacute|Ntilde|Uuml);/g, m => named[m] || m);

  // numéricas dec
  t = t.replace(/&#(\d+);/g, (_, num) => {
    const cp = Number(num);
    if (!isFinite(cp)) return ' ';
    try {
      return String.fromCodePoint(cp);
    } catch (_) {
      return ' ';
    }
  });

  // numéricas hex
  t = t.replace(/&#x([0-9a-fA-F]+);/g, (_, hex) => {
    const cp = parseInt(hex, 16);
    if (!isFinite(cp)) return ' ';
    try {
      return String.fromCodePoint(cp);
    } catch (_) {
      return ' ';
    }
  });

  return t;
}

function normalizeWeirdWhitespace_(s) {
  return String(s || '')
    .replace(/[\u2000-\u200D\uFEFF]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function cleanAndClamp_(s, max) {
  if (!s) return '';
  let t = normalizeWeirdWhitespace_(String(s)).trim();
  return max && t.length > max ? t.slice(0, max) : t;
}

function condenseBank_(s) {
  const txt = cleanAndClamp_(s, MASTER_CFG.BODY_FULL_MAX_CHARS);
  const chunks = txt.split(/(?<=\.)\s+|[\r\n]/);
  const kw =
    /(monto|importe|comercio|merchant|autori|refer|tarjeta|tipo|compra|purchase|fecha|date|usd|crc|eur|\bCRC\b|\bUSD\b|\bEUR\b|\d{1,3}([.,]\d{3})*[.,]\d{2})/i;
  return cleanAndClamp_(chunks.filter(l => kw.test(l)).join(' '), MASTER_CFG.BODY_CONDENSED_MAX);
}

function logPayloadTree_(payload, gmailId) {
  console.log(`🧩 ROOT mimeType=${payload?.mimeType || ''}`);

  const rows = [];
  traverseParts_(payload, p => {
    const mt = String(p.mimeType || '').toLowerCase();
    const b = p.body || {};
    rows.push({
