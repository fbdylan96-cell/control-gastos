  let sh = ss.getSheetByName(SHEET_RAW);
  const requiredHeaders = getRawHeaders_();

  if (!sh) {
    sh = ss.insertSheet(SHEET_RAW);
    sh.appendRow(requiredHeaders);
    return sh;
  }

  const lastCol = sh.getLastColumn();
  if (lastCol < 1) {
    sh.appendRow(requiredHeaders);
    return sh;
  }

  const existingHeaders = sh
    .getRange(1, 1, 1, lastCol)
    .getValues()[0]
    .map(h => String(h || '').trim());

  const missing = requiredHeaders.filter(h => !existingHeaders.includes(h));

  if (missing.length) {
    sh.insertColumnsAfter(lastCol, missing.length);
    sh.getRange(1, lastCol + 1, 1, missing.length).setValues([missing]);
    console.log(`🧩 RAW actualizado: columnas agregadas → ${missing.join(', ')}`);
  }

  return sh;
}

